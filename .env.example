# ─── Backend (la PC donde corre el servidor y la DB) ───

# Directorio del cache de replays parseados (deep links `?r=<id>`).
# Opcional: por defecto `./.cache/replays`. En WSL conviene apuntarlo al
# filesystem de Linux (no a /mnt/...) por performance.
REPLAY_STORAGE_DIR=

# Backend de storage: `local-disk` (default) o `s3` (reservado, falla hasta
# implementar el adapter — evita guardar en otro lado sin querer).
REPLAY_STORAGE_BACKEND=local-disk

# SQLite con el índice de replays (dashboard /api/replays).
# Por defecto `./.cache/replays.db`. Requiere Node 22+.
REPLAY_DB_PATH=

# Orígenes del front publicados que pueden consumir esta API (CORS).
# Lista separada por comas o `*`. Sin esta var, la API queda same-origin.
ALLOWED_ORIGIN=

# ─── Front (el deploy en Vercel) ───

# URL base de la API cuando no corre en el mismo origen que la página,
# p. ej. la PC detrás del túnel: `https://aoe2-api.tu-dominio.com`.
# Es una variable de build: cambiarla exige re-deploy.
NEXT_PUBLIC_API_BASE=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capturas locales del script de verificación
/.screenshots*/

# cache de replays parseados (deep links)
/.cache/
.ai-memory-wiki

# sprites del juego (180 MB, 5372 archivos): los genera tools/sprites de
# sk8erlucas/aoe2-replays contra la instalacion local del juego; NO se
# commitean (los sirve el backend en produccion). Copiarlos a esta repo
# desde /tmp/opencode/sprites-out con tar cuando se regeneren.
public/sprites/
